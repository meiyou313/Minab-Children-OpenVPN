<?xml version="1.0" encoding="utf-8"?>
<!-- Muted gray pill for preserved/stale results restored after test cancel or early stop. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/minab_badge_stale_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/minab_badge_stale_border" />
</shape>
