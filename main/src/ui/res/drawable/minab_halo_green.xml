<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Minab Beta v0.9.6.3 (fix #6) — green halo for the test-progress
  ~ row while a real test runs: a green rounded border with a faint
  ~ green fill, so the running test stands out. Applied in code
  ~ (setRealTestHalo) on Home and on Configs, only while a real
  ~ test runs — the ping test keeps the plain row.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="#140DB37C" />
    <stroke
        android:width="2dp"
        android:color="@color/minab_connected" />
</shape>
