<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#44F59E0B" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#EA580C"
                android:startColor="#FBBF24"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#88FFFFFF" />
        </shape>
    </item>
</layer-list>
