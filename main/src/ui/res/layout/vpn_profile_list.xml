<?xml version="1.0" encoding="utf-8"?>
<!--
  Home tab root: a single virtualised RecyclerView hosting the Home header
  (view type 0) and recycled server rows (view type 1), eliminating the
  NestedScrollView + expandListView O(N) inflate/measure bottleneck that
  caused bottom-tab switching lag.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/minab_home_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />

</FrameLayout>
