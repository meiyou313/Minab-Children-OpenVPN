<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/minab_card_bg"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:id="@+id/faq_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/faq_category_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/minab_version_badge_bg"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/minab_teal_dark"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/faq_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/minab_text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="How does bulk import work?" />
        </LinearLayout>

        <ImageView
            android:id="@+id/faq_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minab_chevron_down"
            android:tint="@color/minab_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/faq_answer_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="9dp"
            android:background="@color/minab_divider" />

        <TextView
            android:id="@+id/faq_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/minab_text_secondary"
            android:textIsSelectable="true"
            android:textSize="12.5sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/faq_tags_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
