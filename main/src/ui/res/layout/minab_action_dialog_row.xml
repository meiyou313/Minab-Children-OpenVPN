<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/minab_chip_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/minab_action_row_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <TextView
        android:id="@+id/minab_action_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn"
        android:maxLines="2"
        android:textColor="@color/minab_text_primary"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/minab_action_row_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/minab_live_stats_bg"
        android:fontFamily="@font/vazirmatn"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:textColor="@color/minab_text_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/minab_action_row_chevron"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_minab_chevron_right"
        android:tint="@color/minab_text_secondary" />
</LinearLayout>
