<?xml version="1.0" encoding="utf-8"?>
<!--
  Home tab header item inside minab_home_recycler: banners, memorial line,
  animated Connect Orb panel (with test-time dimming + touch blocker),
  action buttons, Real test settings panel, dedicated Test Progress box,
  best-server button, group tabs, and search bar.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp">

    <!-- Minimal one-line notification banner -->
    <TextView
        android:id="@+id/notification_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/minab_banner_bg"
        android:drawableStart="@drawable/notifications"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn"
        android:maxLines="1"
        android:padding="8dp"
        android:singleLine="true"
        android:text="@string/minab_notification_off"
        android:textColor="@color/minab_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Update notice banner -->
    <TextView
        android:id="@+id/minab_update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/minab_banner_bg"
        android:backgroundTint="@color/minab_teal_tint"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn"
        android:maxLines="1"
        android:padding="10dp"
        android:singleLine="true"
        android:textColor="@color/minab_teal_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Memorial line -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:text="@string/minab_memorial"
        android:textColor="@color/minab_text_secondary"
        android:textSize="9sp" />

    <!-- Connect section wrapper: allows smoothly dimming the entire connect
         card and blocking interactions while Ping test or Real test runs. -->
    <FrameLayout
        android:id="@+id/minab_connect_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/minab_connect_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_card_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Dynamic animated Connect Orb (distinct colour gradients,
                     glowing halo, orbital arcs, radar ripples & spring pop). -->
                <de.blinkt.openvpn.minab.MinabConnectOrbView
                    android:id="@+id/minab_power_orb"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@string/minab_tap_to_connect" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn"
                            android:text="@string/minab_conn_status"
                            android:textColor="@color/minab_text_secondary"
                            android:textSize="11sp" />

                        <View
                            android:id="@+id/minab_conn_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/minab_status_dot" />

                        <TextView
                            android:id="@+id/minab_conn_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/vazirmatn"
                            android:text="@string/minab_status_disconnected"
                            android:textColor="@color/minab_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn"
                            android:text="@string/minab_conn_name"
                            android:textColor="@color/minab_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/minab_conn_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/vazirmatn"
                            android:maxLines="3"
                            android:textColor="@color/minab_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn"
                            android:text="@string/minab_conn_ip"
                            android:textColor="@color/minab_text_secondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/minab_conn_ip_flag"
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/minab_conn_ip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/vazirmatn"
                            android:textColor="@color/minab_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/vazirmatn"
                            android:text="@string/minab_conn_ping"
                            android:textColor="@color/minab_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/minab_conn_ping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:contentDescription="@string/minab_connected_ping_desc"
                            android:focusable="true"
                            android:fontFamily="@font/vazirmatn"
                            android:textColor="@color/minab_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Live speed, session duration & session data bar (shown while connected) -->
            <LinearLayout
                android:id="@+id/minab_live_stats_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/minab_live_stats_bg"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="7dp"
                android:paddingEnd="6dp"
                android:paddingBottom="7dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="@string/minab_session_down"
                        android:textColor="@color/minab_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/minab_live_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn"
                        android:maxLines="1"
                        android:text="↓ 0 B/s"
                        android:textColor="@color/minab_connected"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="@string/minab_session_up"
                        android:textColor="@color/minab_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/minab_live_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn"
                        android:maxLines="1"
                        android:text="↑ 0 B/s"
                        android:textColor="@color/minab_teal"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="@string/minab_session_duration"
                        android:textColor="@color/minab_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/minab_live_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:maxLines="1"
                        android:text="00:00:00"
                        android:textColor="@color/minab_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="@string/minab_session_total"
                        android:textColor="@color/minab_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/minab_live_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn"
                        android:maxLines="1"
                        android:text="0 B"
                        android:textColor="@color/minab_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Touch-blocking overlay shown while any server test runs -->
        <FrameLayout
            android:id="@+id/minab_connect_blocker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/minab_connect_blocker_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/minab_connect_blocker_pill"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/minab_connect_locked_testing"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- Primary action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_btn_bulk_import"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_minab_import_small"
            android:drawablePadding="4dp"
            android:drawableTint="@android:color/white"
            android:ellipsize="end"
            android:minHeight="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:text="@string/minab_import_short"
            android:textSize="11sp" />

        <Button
            android:id="@+id/minab_btn_ping"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_minab_ping_small"
            android:drawablePadding="4dp"
            android:drawableTint="@color/minab_teal"
            android:ellipsize="end"
            android:minHeight="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:text="@string/minab_test_ping"
            android:textSize="11sp" />

        <Button
            android:id="@+id/minab_btn_real_test"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_minab_ping_small"
            android:drawablePadding="4dp"
            android:drawableTint="@color/minab_teal"
            android:ellipsize="end"
            android:minHeight="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:text="@string/minab_real_test"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/minab_btn_real_test_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minab_real_settings_desc"
            android:src="@drawable/ic_minab_settings"
            android:tint="@color/minab_teal" />

        <ImageButton
            android:id="@+id/minab_btn_test_history"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minab_history_desc"
            android:src="@drawable/ic_minab_history"
            android:tint="@color/minab_teal" />
    </LinearLayout>

    <!-- Inline Real test settings panel -->
    <include layout="@layout/minab_real_test_settings_panel" />

    <!-- Dedicated test progress box (opens immediately on Ping test / Real test) -->
    <include layout="@layout/minab_test_progress_panel" />

    <!-- Connect to best server button -->
    <Button
        android:id="@+id/minab_btn_best_server"
        style="@style/Minab.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_minab_ping_small"
        android:drawablePadding="4dp"
        android:drawableTint="@color/minab_teal"
        android:ellipsize="end"
        android:minHeight="36dp"
        android:singleLine="true"
        android:text="@string/minab_best_server"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_tests_explained"
        android:textColor="@color/minab_text_secondary"
        android:textSize="11sp" />

    <HorizontalScrollView
        android:id="@+id/minab_category_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/minab_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/minab_search"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/minab_input_bg"
                android:fontFamily="@font/vazirmatn"
                android:hint="@string/minab_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="34dp"
                android:singleLine="true"
                android:textColor="@color/minab_text_primary"
                android:textColorHint="@color/minab_text_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/minab_search_clear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/minab_clear_search_desc"
                android:padding="6dp"
                android:src="@drawable/ic_minab_clear_small"
                android:tint="@color/minab_text_secondary"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/minab_btn_sort"
            style="@style/Minab.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_minab_sort"
            android:drawablePadding="4dp"
            android:drawableTint="@color/minab_teal"
            android:minWidth="0dp"
            android:minHeight="38dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/minab_sort_short_real"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/minab_btn_tools"
            android:layout_width="36dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/minab_input_bg"
            android:contentDescription="@string/minab_tools_menu_title"
            android:padding="8dp"
            android:src="@drawable/ic_minab_dedup"
            android:tint="@color/minab_teal" />
    </LinearLayout>

</LinearLayout>
