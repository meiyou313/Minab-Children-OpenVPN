<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/minab_dialog_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_sort_title"
            android:textColor="@color/minab_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/minab_sort_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minab_test_dismiss_btn"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_close_24"
            android:tint="@color/minab_text_secondary" />
    </LinearLayout>

    <!-- 1. Real Test (Default & Recommended Best) -->
    <LinearLayout
        android:id="@+id/minab_sort_opt_real"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/minab_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/minab_sort_label_real"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_sort_opt_real"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/minab_ping_badge_fast"
            android:fontFamily="@font/vazirmatn"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/minab_sort_best_badge"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/minab_sort_check_real"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_minab_check_circle"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. Ping -->
    <LinearLayout
        android:id="@+id/minab_sort_opt_ping"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/minab_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/minab_sort_label_ping"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_sort_opt_ping"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/minab_sort_check_ping"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_minab_check_circle"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Country / Group -->
    <LinearLayout
        android:id="@+id/minab_sort_opt_country"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/minab_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/minab_sort_label_country"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_sort_opt_country"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/minab_sort_check_country"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_minab_check_circle"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 4. Name (A-Z) -->
    <LinearLayout
        android:id="@+id/minab_sort_opt_name"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/minab_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/minab_sort_label_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_sort_opt_name"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/minab_sort_check_name"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_minab_check_circle"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 5. Recently Used -->
    <LinearLayout
        android:id="@+id/minab_sort_opt_lru"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/minab_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/minab_sort_label_lru"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_sort_opt_lru"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/minab_sort_check_lru"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_minab_check_circle"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
