<?xml version="1.0" encoding="utf-8"?>
<!--
  Configs tab root: a single virtualised RecyclerView hosting the Configs
  header (view type 0) and recycled config rows (view type 1), eliminating
  the NestedScrollView + expandListView bottleneck on tab switches.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/minab_configs_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />

</FrameLayout>
