<?xml version="1.0" encoding="utf-8"?>
<!--
  Minab Beta v0.9.7 — Large Dashboard Widget (4×2).
  Shows brand header + live state pill (opens app), active server + flag,
  glossy Power Orb toggle, live download/upload speeds, and 1-tap Best Server button.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_widget_card_idle"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header bar: Logo + App name + State pill (tapping opens Minab) -->
    <LinearLayout
        android:id="@+id/minab_widget_large_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/app"
            android:src="@drawable/ic_logo_bunt" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minab_widget_large_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_widget_state_pill_idle"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/minab_status_disconnected"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle: Server info + glossy Power Orb toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/minab_widget_large_server_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/minab_widget_large_flag"
                    android:layout_width="22dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="@string/minab_flag_description"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/minab_widget_large_server"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/minab_widget_ready"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/minab_widget_large_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/minab_tap_to_connect"
                android:textColor="#C7D2FE"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/minab_widget_large_orb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/minab_widget_orb_idle">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/minab_tap_to_connect"
                android:src="@drawable/ic_minab_power_white" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom bar: Live Down / Up speeds + Quick Best Server connect button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/minab_widget_large_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/minab_widget_pill_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="5dp"
            android:text="↓ 0 B/s"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minab_widget_large_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/minab_widget_pill_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="5dp"
            android:text="↑ 0 B/s"
            android:textColor="#A5B4FC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minab_widget_large_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_widget_state_pill_idle"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/minab_widget_best_short"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
