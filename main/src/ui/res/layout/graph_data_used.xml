<?xml version="1.0" encoding="utf-8"?><!--
  ~ Minab Beta v0.7 — "Data used" header for the Graph tab.
  ~ A card with three toggleable bar-chart views (daily / weekly /
  ~ monthly) of the real measured download + upload, then a
  ~ "Live speed" heading above the existing live line charts.
  ~ The bars are built in code (GraphFragment.renderDataUsed) from
  ~ plain Views — no chart library — inside minab_data_bars.
  ~
  ~ Minab Beta v0.8 — the Daily / Weekly / Monthly chips looked
  ~ half-cut on the phone: a stock Button is 48dp tall by default
  ~ with font padding, so at 32dp the 12sp Vazirmatn text was
  ~ clipped top and bottom. The chips are now 36dp with no minimum
  ~ height, no padding and no font padding, so the text sits
  ~ centred and whole; the background is set here too (the code
  ~ in updateDataChips still swaps it for the active one).
  -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/minab_card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_data_used"
            android:textColor="@color/minab_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minab_data_daily"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_daily"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/minab_data_weekly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_weekly"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/minab_data_monthly"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_monthly"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/minab_data_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_data_none_yet"
            android:textColor="@color/minab_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Minab Beta v0.9.1 — the Daily strip is 50 bars, wider
             than the screen, so it scrolls sideways (fix #3). -->
        <HorizontalScrollView
            android:id="@+id/minab_data_bars_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/minab_data_bars"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:gravity="bottom"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Minab Beta v0.9.6.1 (fix #5) — "jump to the current
             bar" icon at the right end of the Total row (the spot
             the user marked with a red pen): it scrolls the strip
             straight to the bar for the period we are in.
             Minab Beta v0.9.6.5 (fix #5) — Total, the tapped
             period and the jump icon all in ONE row now (11sp),
             instead of Total + icon on one line and the period
             ("November 2026 · 1.94 GB") on a line of its own
             below. The row hides with the Total when there is no
             data yet (see GraphFragment). -->
        <LinearLayout
            android:id="@+id/minab_data_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minab_data_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Minab Beta v0.9.6.1 (fix #7) — the date / range of
                 the bar the user tapped ("Sat 14 Nov 2026 ·
                 1.54 GB"). Hidden until the first tap. -->
            <TextView
                android:id="@+id/minab_data_selected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/minab_text_primary"
                android:textSize="11sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/minab_data_jump_current"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/minab_data_jump_current_desc"
                android:src="@drawable/minab_ic_jump_current" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_live_speed"
        android:textColor="@color/minab_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
