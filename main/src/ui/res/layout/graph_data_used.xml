<?xml version="1.0" encoding="utf-8"?>
<!-- Minab Beta — unified scrollable header: live speed summary, Data used bars,
     and Live speed section heading with its logarithmic scale toggle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 1. Live connection speed summary card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/minab_card_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_graph_live_card_title"
            android:textColor="@color/minab_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_live_stats_bg"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_graph_download"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/minab_graph_down_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:text="↓ 0 bit/s"
                    android:textColor="@color/minab_connected"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/minab_graph_down_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:text="0 B"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_live_stats_bg"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_graph_upload"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/minab_graph_up_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:text="↑ 0 bit/s"
                    android:textColor="@color/minab_teal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/minab_graph_up_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:text="0 B"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Legacy status line hidden cleanly; structured cards above show download/upload -->
        <TextView
            android:id="@+id/speedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="speed status" />
    </LinearLayout>

    <!-- 2. Data used bar chart card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/minab_card_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_data_used"
            android:textColor="@color/minab_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minab_data_daily"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_daily"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/minab_data_weekly"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_weekly"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/minab_data_monthly"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/minab_btn_outline"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/minab_data_monthly"
                android:textAllCaps="false"
                android:textColor="@color/minab_teal"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/minab_data_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_data_none_yet"
            android:textColor="@color/minab_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/minab_data_bars_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/minab_data_bars"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:gravity="bottom"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/minab_data_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minab_data_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minab_data_selected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/minab_text_primary"
                android:textSize="11sp"
                android:visibility="invisible" />

            <ImageButton
                android:id="@+id/minab_data_jump_current"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/minab_data_jump_current_desc"
                android:src="@drawable/minab_ic_jump_current" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Live speed section heading + logarithmic scale toggle (controls the 3 line charts below) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_live_speed"
            android:textColor="@color/minab_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/useLogScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/minab_teal"
            android:fontFamily="@font/vazirmatn"
            android:minHeight="0dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/use_logarithmic_scale"
            android:textColor="@color/minab_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
