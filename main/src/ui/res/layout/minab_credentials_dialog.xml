<?xml version="1.0" encoding="utf-8"?><!--
  ~ Minab Beta v0.9.6.5 (fix #3) — the username/password dialog
  ~ that appears after picking config files on the Bulk import
  ~ page, when no credentials are filled in anywhere yet. Same
  ~ card look as the page (rounded inputs, Vazirmatn); the fields
  ~ on the page itself stay as they are.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_bulk_credentials_title"
        android:textColor="@color/minab_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_bulk_credentials_hint"
        android:textColor="@color/minab_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/minab_credentials_fill_saved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/minab_chip_bg_selected"
        android:fontFamily="@font/vazirmatn"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/minab_teal_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <EditText
        android:id="@+id/minab_credentials_dialog_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/minab_input_bg"
        android:fontFamily="@font/vazirmatn"
        android:hint="@string/minab_username"
        android:inputType="textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/minab_text_primary" />

    <EditText
        android:id="@+id/minab_credentials_dialog_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/minab_input_bg"
        android:fontFamily="@font/vazirmatn"
        android:hint="@string/minab_password"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="@color/minab_text_primary" />

</LinearLayout>
