<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/minab_dialog_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minab_key_small"
            android:tint="@color/minab_teal" />

        <TextView
            android:id="@+id/minab_creds_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_configs_login_btn"
            android:textColor="@color/minab_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Prominent Scope Banner: green outline for group/selected, amber warning for ALL -->
    <LinearLayout
        android:id="@+id/minab_creds_scope_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/minab_scope_banner_safe"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/minab_creds_scope_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minab_check_circle"
            android:tint="@color/minab_connected" />

        <TextView
            android:id="@+id/minab_creds_scope_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Optional saved credentials quick-fill pill -->
    <LinearLayout
        android:id="@+id/minab_creds_fill_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/minab_creds_fill_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_chip_bg_selected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/minab_fill_saved_creds"
            android:textColor="@color/minab_teal_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/minab_creds_user"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/minab_input_bg"
        android:fontFamily="@font/vazirmatn"
        android:hint="@string/auth_username"
        android:imeOptions="actionNext"
        android:inputType="textNoSuggestions"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/minab_text_primary"
        android:textColorHint="@color/minab_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/minab_input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/minab_creds_pass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/vazirmatn"
            android:hint="@string/password"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/minab_text_primary"
            android:textColorHint="@color/minab_text_secondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/minab_creds_pass_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minab_toggle_password"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_minab_eye"
            android:tint="@color/minab_text_secondary" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/minab_creds_save_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/minab_teal"
        android:checked="false"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_creds_save_default"
        android:textColor="@color/minab_text_secondary"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_creds_cancel"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@android:string/cancel"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/minab_creds_save"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/minab_apply_credentials"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
