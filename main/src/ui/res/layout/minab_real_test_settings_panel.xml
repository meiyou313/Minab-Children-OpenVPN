<?xml version="1.0" encoding="utf-8"?><!--
  ~ Minab Beta v0.9.6.2 (fixes #1, #6) — the Real test settings
  ~ panel: an inline card that opens directly UNDER the Real test
  ~ button (in the Home header and in the Configs header), instead
  ~ of the ugly 0.9.6.1 AlertDialog. Same three settings with
  ~ "Recommended: …" hints and a "Reset to recommended" action.
  ~ Shared by Home and Configs through MinabRealTestSettingsPanel,
  ~ so both tabs behave exactly the same. Hidden by default; the
  ~ gear icon is green while it is open, blue while closed.
  ~ Minab Beta v0.9.6.3 (fix #2) — smaller and more minimal:
  ~ tighter padding/margins, smaller fonts and steppers, so the
  ~ panel no longer takes half the screen.
  ~ Minab Beta v0.9.6.4 (fix #7) — smaller STILL: the 0.9.6.3
  ~ panel was still big and full of empty space. Padding 6dp,
  ~ 4dp between sections, 10sp labels, 9sp hints, 28dp steppers —
  ~ about a third shorter, nothing removed.
  ~ Minab Beta v0.9.6.5 (fix #1) — the value + steppers sit IN
  ~ the same row as the title now (label + hint on the left, the
  ~ stepper on the right), so each setting takes one row instead
  ~ of three and the panel is shorter still. And the steppers are
  ~ ImageButtons with explicit plus/minus vectors in bordered
  ~ buttons: the old text Buttons ("+"/"−") rendered INVISIBLY
  ~ on the phone in 0.9.6.4, so the user could not see any way
  ~ to change the numbers at all.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_real_settings_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/minab_card_bg"
    android:orientation="vertical"
    android:padding="6dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_real_settings_title"
            android:textColor="@color/minab_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minab_real_settings_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn"
            android:padding="4dp"
            android:text="@string/minab_real_settings_reset"
            android:textColor="@color/minab_teal"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Wait per server: label + hint on the left, stepper on the
         right, all in one row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_wait"
                android:textColor="@color/minab_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_wait_hint"
                android:textColor="@color/minab_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/minab_real_settings_wait_minus"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_wait_minus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_minus" />

        <TextView
            android:id="@+id/minab_real_settings_wait_value"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/minab_real_settings_wait_plus"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_wait_plus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_plus" />
    </LinearLayout>

    <!-- Healthy servers to find: same one-row pattern. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_max"
                android:textColor="@color/minab_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_max_hint"
                android:textColor="@color/minab_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/minab_real_settings_max_minus"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_max_minus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_minus" />

        <TextView
            android:id="@+id/minab_real_settings_max_value"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/minab_real_settings_max_plus"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_max_plus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_plus" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_real_settings_unpinged"
            android:textColor="@color/minab_text_primary"
            android:textSize="10sp" />

        <CheckBox
            android:id="@+id/minab_real_settings_unpinged_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/minab_real_settings_unpinged" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_real_settings_unpinged_hint"
        android:textColor="@color/minab_text_secondary"
        android:textSize="9sp" />

</LinearLayout>
