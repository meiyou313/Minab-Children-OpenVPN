<?xml version="1.0" encoding="utf-8"?>
<!--
  Minab Beta v0.9.7.1 — Real test settings panel shared between Home and Configs:
  - Bordered pill around "Reset to recommended"
  - 20s wait, 10 healthy servers defaults
  - 10 curated target URLs + Custom URL picker
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_real_settings_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/minab_card_bg"
    android:orientation="vertical"
    android:padding="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_real_settings_title"
            android:textColor="@color/minab_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minab_real_settings_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="@string/minab_real_settings_reset"
            android:textColor="@color/minab_teal"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Wait per server -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_wait"
                android:textColor="@color/minab_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_wait_hint"
                android:textColor="@color/minab_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/minab_real_settings_wait_minus"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_wait_minus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_minus" />

        <TextView
            android:id="@+id/minab_real_settings_wait_value"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/minab_real_settings_wait_plus"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_wait_plus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_plus" />
    </LinearLayout>

    <!-- Healthy servers to find -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_max"
                android:textColor="@color/minab_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_max_hint"
                android:textColor="@color/minab_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/minab_real_settings_max_minus"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_max_minus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_minus" />

        <TextView
            android:id="@+id/minab_real_settings_max_value"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/minab_real_settings_max_plus"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/minab_btn_outline"
            android:contentDescription="@string/minab_real_settings_max_plus_desc"
            android:scaleType="center"
            android:src="@drawable/minab_ic_plus" />
    </LinearLayout>

    <!-- Target server URL selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_url"
                android:textColor="@color/minab_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_url_hint"
                android:textColor="@color/minab_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/minab_real_settings_url_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/minab_chip_bg_selected"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:maxWidth="156dp"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="api.telegram.org"
            android:textColor="@color/minab_teal_dark"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Test unpinged toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_unpinged"
                android:textColor="@color/minab_text_primary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_real_settings_unpinged_hint"
                android:textColor="@color/minab_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/minab_real_settings_unpinged_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/minab_teal"
            android:contentDescription="@string/minab_real_settings_unpinged" />
    </LinearLayout>

</LinearLayout>
