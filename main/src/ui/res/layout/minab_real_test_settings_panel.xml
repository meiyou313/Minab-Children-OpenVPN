<?xml version="1.0" encoding="utf-8"?><!--
  ~ Minab Beta v0.9.6.2 (fixes #1, #6) — the Real test settings
  ~ panel: an inline card that opens directly UNDER the Real test
  ~ button (in the Home header and in the Configs header), instead
  ~ of the ugly 0.9.6.1 AlertDialog. Same three settings with
  ~ "Recommended: …" hints and a "Reset to recommended" action.
  ~ Shared by Home and Configs through MinabRealTestSettingsPanel,
  ~ so both tabs behave exactly the same. Hidden by default; the
  ~ gear icon is green while it is open, blue while closed.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_real_settings_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/minab_card_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_real_settings_title"
            android:textColor="@color/minab_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minab_real_settings_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn"
            android:padding="4dp"
            android:text="@string/minab_real_settings_reset"
            android:textColor="@color/minab_teal"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_real_settings_wait"
        android:textColor="@color/minab_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_real_settings_wait_hint"
        android:textColor="@color/minab_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_real_settings_wait_minus"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:minWidth="48dp"
            android:minHeight="40dp"
            android:text="−"
            android:textColor="@color/minab_teal"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/minab_real_settings_wait_value"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/minab_real_settings_wait_plus"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:minWidth="48dp"
            android:minHeight="40dp"
            android:text="+"
            android:textColor="@color/minab_teal"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_real_settings_max"
        android:textColor="@color/minab_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_real_settings_max_hint"
        android:textColor="@color/minab_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_real_settings_max_minus"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:minWidth="48dp"
            android:minHeight="40dp"
            android:text="−"
            android:textColor="@color/minab_teal"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/minab_real_settings_max_value"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/minab_real_settings_max_plus"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:minWidth="48dp"
            android:minHeight="40dp"
            android:text="+"
            android:textColor="@color/minab_teal"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_real_settings_unpinged"
            android:textColor="@color/minab_text_primary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/minab_real_settings_unpinged_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/minab_real_settings_unpinged" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/vazirmatn"
        android:text="@string/minab_real_settings_unpinged_hint"
        android:textColor="@color/minab_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
