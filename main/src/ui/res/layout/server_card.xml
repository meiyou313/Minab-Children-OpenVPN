<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@drawable/minab_card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header row: Enable toggle + Remove button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/remoteSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/enabled_connection_entry"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:thumbTint="@color/minab_switch_thumb"
                android:trackTint="@color/minab_switch_track" />

            <ImageButton
                android:id="@+id/remove_connection"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/remove_connection_entry"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_delete_grey"
                android:tint="@color/minab_danger" />
        </LinearLayout>

        <!-- Server Address + Port -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/server_label"
                style="@style/Minab.EditLabel"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/address" />

            <TextView
                android:id="@+id/port_label"
                style="@style/Minab.EditLabel"
                android:layout_width="82dp"
                android:layout_marginTop="0dp"
                android:text="@string/port" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/servername"
                style="@style/Minab.EditInput"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:inputType="textUri"
                android:singleLine="true"
                tools:ignore="HardcodedText"
                tools:text="openvpn.blinkt.de" />

            <EditText
                android:id="@+id/portnumber"
                style="@style/Minab.EditInput"
                android:layout_width="82dp"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:text="1194"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Protocol -->
        <TextView
            android:id="@+id/protocol"
            style="@style/Minab.EditLabel"
            android:text="@string/protocol" />

        <RadioGroup
            android:id="@+id/udptcpradiogroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/udp_proto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/minab_teal"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="32dp"
                android:text="UDP"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <RadioButton
                android:id="@+id/tcp_proto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/minab_teal"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="32dp"
                android:text="TCP"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </RadioGroup>

        <!-- Proxy type -->
        <TextView
            android:id="@+id/proxy_label"
            style="@style/Minab.EditLabel"
            android:text="@string/proxy" />

        <de.blinkt.openvpn.views.MultiLineRadioGroup
            android:id="@+id/proxyradiogroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/proxy_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/minab_teal"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="32dp"
                android:text="@string/Use_no_proxy"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <RadioButton
                android:id="@+id/proxy_http"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/minab_teal"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="32dp"
                android:text="HTTP"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <RadioButton
                android:id="@+id/proxy_socks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/minab_teal"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="32dp"
                android:text="Socksv5"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <RadioButton
                android:id="@+id/proxy_orbot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/minab_teal"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="32dp"
                android:text="@string/tor_orbot"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp" />
        </de.blinkt.openvpn.views.MultiLineRadioGroup>

        <!-- Proxy Address + Port (all 4 toggle together to GONE when proxy = NONE/ORBOT) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/proxyserver_label"
                style="@style/Minab.EditLabel"
                android:layout_width="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/address" />

            <TextView
                android:id="@+id/proxyport_label"
                style="@style/Minab.EditLabel"
                android:layout_width="82dp"
                android:layout_marginTop="8dp"
                android:text="@string/port" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/proxyname"
                style="@style/Minab.EditInput"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:inputType="textUri"
                android:singleLine="true"
                tools:ignore="HardcodedText"
                tools:text="proxy.blinkt.de" />

            <EditText
                android:id="@+id/proxyport"
                style="@style/Minab.EditInput"
                android:layout_width="82dp"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:text="8080"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Proxy Authentication -->
        <LinearLayout
            android:id="@+id/proxyauthlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <CheckBox
                android:id="@+id/enable_proxy_auth"
                style="@style/Minab.EditCheckBox"
                android:text="@string/enableproxyauth" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/httpuser_label"
                    style="@style/Minab.EditLabel"
                    android:layout_width="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/proxy_auth_username" />

                <TextView
                    android:id="@+id/httppassword_label"
                    style="@style/Minab.EditLabel"
                    android:layout_width="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:text="@string/auth_pwquery" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/proxyuser"
                    style="@style/Minab.EditInput"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="username"
                    android:inputType="text"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/proxypassword"
                    style="@style/Minab.EditInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    tools:ignore="HardcodedText"
                    tools:text="geheim" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connect Timeout -->
        <TextView
            android:id="@+id/connect_timeout_label"
            style="@style/Minab.EditLabel"
            android:text="@string/connect_timeout" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/connect_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="300"
                android:progressTint="@color/minab_teal"
                android:thumbTint="@color/minab_teal" />

            <EditText
                android:id="@+id/connect_timeout"
                style="@style/Minab.EditInput"
                android:layout_width="64dp"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:labelFor="@id/connect_slider"
                tools:text="232" />
        </LinearLayout>

        <!-- Custom Connection Options -->
        <CheckBox
            android:id="@+id/use_customoptions"
            style="@style/Minab.EditCheckBox"
            android:layout_marginTop="6dp"
            android:text="@string/custom_connection_options" />

        <LinearLayout
            android:id="@+id/custom_options_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/warning_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/vazirmatn"
                android:labelFor="@id/customoptions"
                android:text="@string/custom_connection_options_warning"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11.5sp" />

            <EditText
                android:id="@+id/customoptions"
                style="@style/Minab.EditInput"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:singleLine="false"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
