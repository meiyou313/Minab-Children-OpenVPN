<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/minab_diag_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/minab_surface"
        android:orientation="vertical"
        android:padding="14dp">

    <!-- Strictly local-only privacy reassurance banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/minab_scope_banner_safe"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minab_shield"
            app:tint="@color/minab_connected" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn"
            android:text="@string/minab_diag_local_only_banner"
            android:textColor="@color/minab_text_primary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- GitHub Issues clickable card -->
    <LinearLayout
        android:id="@+id/minab_diag_github_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/minab_chip_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minab_info_circle"
            app:tint="@color/minab_teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_diag_github_title"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_diag_github_url"
                android:textColor="@color/minab_teal_dark"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minab_chevron_right"
            app:tint="@color/minab_text_secondary" />
    </LinearLayout>

    <!-- 4 category tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minab_diag_tab_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/minab_chip_bg_selected"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/minab_diag_tab_overview"
                android:textColor="@color/minab_teal_dark"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minab_diag_tab_crashes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/minab_chip_bg"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/minab_diag_tab_crashes"
                android:textColor="@color/minab_chip_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/minab_diag_tab_applog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/minab_chip_bg"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/minab_diag_tab_applog"
                android:textColor="@color/minab_chip_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/minab_diag_tab_ovpnlog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/minab_chip_bg"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/minab_diag_tab_ovpnlog"
                android:textColor="@color/minab_chip_text"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Monospace log display -->
    <ScrollView
        android:id="@+id/minab_diag_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/minab_card_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/minab_diag_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/minab_text_primary"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_diag_btn_save"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_download_24"
            android:drawablePadding="4dp"
            android:drawableTint="@android:color/white"
            android:minHeight="38dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/minab_diag_download_txt"
            android:textSize="11.5sp" />

        <Button
            android:id="@+id/minab_diag_btn_share"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_minab_share_small"
            android:drawablePadding="4dp"
            android:drawableTint="@color/minab_teal"
            android:minHeight="38dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/minab_diag_share_txt"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_diag_btn_copy"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_baseline_file_copy_24"
            android:drawablePadding="4dp"
            android:drawableTint="@color/minab_teal"
            android:minHeight="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/minab_diag_copy"
            android:textSize="11.5sp" />

        <Button
            android:id="@+id/minab_diag_btn_clear"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_baseline_delete_outline_24"
            android:drawablePadding="4dp"
            android:drawableTint="@color/minab_danger"
            android:minHeight="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/minab_crash_clear"
            android:textColor="@color/minab_danger"
            android:textSize="11.5sp" />
    </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/statusbar_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/primary_dark" />

</FrameLayout>
