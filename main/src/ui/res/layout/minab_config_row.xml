<?xml version="1.0" encoding="utf-8"?>
<!--
  Configs RecyclerView row inside the grouped server card.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_config_card_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/minab_row_card_middle">

    <LinearLayout
        android:id="@+id/minab_config_row_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <CheckBox
            android:id="@+id/minab_config_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:buttonTint="@color/minab_teal"
            android:focusable="false" />

        <TextView
            android:id="@+id/minab_config_index"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/minab_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/minab_config_flag"
            android:layout_width="22dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/minab_flag_description" />

        <ProgressBar
            android:id="@+id/minab_config_connecting_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/minab_connected"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/minab_config_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="2"
                android:textColor="@color/minab_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/minab_config_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="1"
                android:textColor="@color/minab_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/minab_config_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/minab_config_ping_badge"
                style="@style/Minab.PingBadge"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/minab_ping_badge_fast"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/minab_config_real_badge"
                style="@style/Minab.PingBadge"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/minab_ping_badge_fast"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:visibility="invisible" />
        </LinearLayout>

        <ImageView
            android:id="@+id/minab_config_star"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/minab_favorite_desc"
            android:src="@drawable/minab_star_off" />

        <ImageView
            android:id="@+id/minab_config_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/configure_the_vpn"
            android:src="@drawable/ic_edit" />

    </LinearLayout>
</FrameLayout>
