<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/minab_chip_bg"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/minab_cat_row_icon"
        android:layout_width="22dp"
        android:layout_height="16dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/minab_cat_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn"
        android:maxLines="1"
        android:textColor="@color/minab_text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/minab_cat_row_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/minab_live_stats_bg"
        android:fontFamily="@font/vazirmatn"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:textColor="@color/minab_text_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/minab_cat_row_rename"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/minab_rename_category"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_edit"
        android:tint="@color/minab_teal" />

    <ImageButton
        android:id="@+id/minab_cat_row_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/minab_delete_category"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_baseline_delete_outline_24"
        android:tint="@color/minab_danger" />
</LinearLayout>
