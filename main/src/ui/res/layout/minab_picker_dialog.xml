<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/minab_dialog_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/minab_picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/vazirmatn"
        android:textColor="@color/minab_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/minab_picker_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/minab_picker_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/minab_picker_close"
        style="@style/Minab.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:minHeight="36dp"
        android:text="@string/minab_test_dismiss_btn"
        android:textSize="12sp" />

</LinearLayout>
