<?xml version="1.0" encoding="utf-8"?>
<!--
  Minab Beta v0.9.7 — minimal, modular, standard Bulk Import screen:
  1. Top Live Progress / Applied Success Card (with clear "Done · Back to menu" button)
  2. Add Configs Card (side-by-side .ovpn / .zip pickers + IP country auto-detection)
  3. Link Import & Restore Backup Card
  4. Shared Login Card (optional)
  5. Clear bottom Back button
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_bulk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Prominent Live Progress & Applied Success Card -->
        <LinearLayout
            android:id="@+id/minab_bulk_result_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/minab_bulk_result_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/minab_bulk_done_title"
                    android:src="@drawable/ic_minab_check_circle"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/minab_bulk_result_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_importing"
                    android:textColor="@color/minab_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/minab_bulk_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/minab_divider"
                android:progressTint="@color/minab_teal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/minab_bulk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/minab_bulk_skip_geoip"
                style="@style/Minab.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:minHeight="34dp"
                android:text="@string/minab_bulk_skip_geoip"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/minab_bulk_done_btn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/minab_btn_best_glow"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="40dp"
                android:text="@string/minab_bulk_back_home"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Add Configs & Grouping Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_bulk_step_add"
                android:textColor="@color/minab_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/minab_bulk_pick"
                    style="@style/Minab.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_minab_import_small"
                    android:drawablePadding="6dp"
                    android:drawableTint="@android:color/white"
                    android:ellipsize="end"
                    android:minHeight="38dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/minab_pick_files"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/minab_bulk_pick_zip"
                    style="@style/Minab.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_baseline_archive_24"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/minab_teal"
                    android:ellipsize="end"
                    android:minHeight="38dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/minab_pick_zip"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_import_category"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/minab_bulk_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:popupBackground="@drawable/minab_card_bg" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/minab_bulk_auto_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:buttonTint="@color/minab_teal"
                android:checked="true"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp"
                android:text="@string/minab_bulk_auto_ip_hint"
                android:textColor="@color/minab_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Import from Link & Restore Backup Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_bulk_step_more"
                android:textColor="@color/minab_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/minab_bulk_url"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/minab_input_bg"
                android:fontFamily="@font/vazirmatn"
                android:hint="@string/minab_import_url_hint"
                android:inputType="textUri"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/minab_text_primary"
                android:textColorHint="@color/minab_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/minab_bulk_fetch_url"
                    style="@style/Minab.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:minHeight="36dp"
                    android:singleLine="true"
                    android:text="@string/minab_fetch_url"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/minab_bulk_restore"
                    style="@style/Minab.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:text="@string/minab_restore_backup"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Scoped Shared Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_bulk_step_login"
                    android:textColor="@color/minab_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/minab_bulk_fill_saved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/minab_chip_bg_selected"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/minab_teal_dark"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/minab_bulk_username"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/minab_input_bg"
                    android:fontFamily="@font/vazirmatn"
                    android:hint="@string/minab_username"
                    android:inputType="textNoSuggestions"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/minab_text_primary"
                    android:textColorHint="@color/minab_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/minab_bulk_password"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/minab_input_bg"
                    android:fontFamily="@font/vazirmatn"
                    android:hint="@string/minab_password"
                    android:inputType="textPassword"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/minab_text_primary"
                    android:textColorHint="@color/minab_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/minab_bulk_apply_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/minab_teal"
                android:checked="true"
                android:fontFamily="@font/vazirmatn"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/minab_apply_to_all"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/minab_bulk_login_scope"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/minab_input_bg"
                    android:popupBackground="@drawable/minab_card_bg" />

                <Button
                    android:id="@+id/minab_bulk_apply_credentials"
                    style="@style/Minab.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:text="@string/minab_apply_credentials"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Last import caption & prominent Back to Menu button -->
        <TextView
            android:id="@+id/minab_bulk_last_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:textColor="@color/minab_text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/minab_bulk_footer_back"
            style="@style/Minab.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:minHeight="40dp"
            android:text="@string/minab_bulk_back_home"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
