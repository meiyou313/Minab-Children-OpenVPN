<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_sparkle_menu_root"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/minab_smart_tools_title"
    android:focusable="true">

    <ImageView
        android:id="@+id/minab_sparkle_menu_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_minab_sparkle"
        android:tint="#FFFFFF" />

    <View
        android:id="@+id/minab_sparkle_menu_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/minab_green_dot_badge"
        android:visibility="gone" />
</FrameLayout>
