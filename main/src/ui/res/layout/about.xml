<?xml version="1.0" encoding="utf-8"?>
<!-- Minab Beta v0.9.7.1 — compact, single-screen About layout with aligned buttons -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_home_gradient"
    android:clipToPadding="false"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <!-- 1. Compact Hero brand card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/app"
                    android:src="@drawable/ic_logo_bunt" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="@string/app"
                        android:textColor="@color/minab_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="@string/minab_about_subtitle"
                        android:textColor="@color/minab_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/minab_version_badge_bg"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/minab_teal_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="0.9.7.1" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/minab_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:text="@string/minab_memorial"
                android:textColor="@color/minab_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 2. Dynamic App Update card -->
        <LinearLayout
            android:id="@+id/minab_about_update_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_about_update_card_title"
                    android:textColor="@color/minab_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/minab_update_badge_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/minab_version_badge_bg"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingStart="9dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/minab_teal_dark"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="v0.9.8" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/minab_update_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/minab_teal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_update_checking"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/minab_update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/minab_live_stats_bg"
                android:fontFamily="@font/vazirmatn"
                android:padding="8dp"
                android:textColor="@color/minab_text_primary"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/minab_about_download_btn"
                style="@style/Minab.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:minHeight="38dp"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Download v0.9.8" />

            <Button
                android:id="@+id/minab_about_assets_btn"
                style="@style/Minab.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:minHeight="36dp"
                android:text="@string/minab_about_open_release_assets"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/minab_about_check_update"
                style="@style/Minab.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:minHeight="38dp"
                android:text="@string/minab_check_update"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Formal Features card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_about_highlights_title"
                android:textColor="@color/minab_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minab_about_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/vazirmatn"
                android:lineSpacingExtra="2dp"
                android:text="@string/minab_about_highlights_body"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Project & Source card (level, evenly aligned single-line buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/minab_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_about_links_title"
                android:textColor="@color/minab_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/minab_about_github_btn"
                    style="@style/Minab.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:text="@string/minab_about_open_github"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/minab_about_releases_btn"
                    style="@style/Minab.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:text="@string/minab_about_open_releases"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/vazirmatn"
                android:text="@string/minab_about_credits"
                android:textColor="@color/minab_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
