<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated test progress box on Home & Configs:
  - Expanded live view during Ping test / Real test
  - Auto-collapsed 1-line summary bar when finished
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_test_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/minab_test_panel_bg_ping"
    android:orientation="vertical"
    android:padding="10dp"
    android:visibility="gone">

    <!-- Expanded live view while running -->
    <LinearLayout
        android:id="@+id/minab_test_expanded_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/minab_test_spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/minab_teal" />

            <TextView
                android:id="@+id/minab_test_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="1"
                android:text="@string/minab_test_panel_ping_title"
                android:textColor="@color/minab_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minab_test_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/minab_test_stat_bg"
                android:fontFamily="@font/vazirmatn"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/minab_teal"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/minab_test_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/minab_test_progress_drawable" />

        <LinearLayout
            android:id="@+id/minab_test_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_test_stat_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/minab_test_stat_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="0"
                    android:textColor="@color/minab_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_test_stat_tested"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/minab_test_stat_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/minab_test_stat_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="0"
                    android:textColor="@color/minab_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_test_stat_remaining"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/minab_test_stat_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/minab_test_stat_found"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="0"
                    android:textColor="@color/minab_connected"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/minab_test_stat_found_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="@string/minab_test_stat_responded"
                    android:textColor="@color/minab_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minab_test_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="2"
                android:textColor="@color/minab_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/minab_test_cancel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/minab_btn_cancel_bg"
                android:fontFamily="@font/vazirmatn"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/minab_test_cancel_btn"
                android:textAllCaps="false"
                android:textColor="@color/minab_danger"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact 1-line summary bar shown automatically on finish -->
    <LinearLayout
        android:id="@+id/minab_test_compact_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/minab_test_compact_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/minab_test_panel_real_done_title"
            android:src="@drawable/ic_minab_check_circle" />

        <TextView
            android:id="@+id/minab_test_compact_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/minab_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/minab_test_dismiss"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minab_test_dismiss_btn"
            android:src="@drawable/ic_minab_clear_small"
            android:tint="@color/minab_text_secondary" />
    </LinearLayout>
</LinearLayout>
