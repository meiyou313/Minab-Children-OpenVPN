<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/minab_dialog_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/minab_input_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/vazirmatn"
        android:textColor="@color/minab_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/minab_input_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/vazirmatn"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/minab_text_secondary"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/minab_input_dialog_field"
        style="@style/Minab.EditInput"
        android:layout_marginBottom="12dp"
        android:inputType="text"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minab_input_dialog_cancel"
            style="@style/Minab.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@android:string/cancel"
            android:textSize="12sp" />

        <Button
            android:id="@+id/minab_input_dialog_ok"
            style="@style/Minab.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@android:string/ok"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
