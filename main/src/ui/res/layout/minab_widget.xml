<?xml version="1.0" encoding="utf-8"?>
<!--
  Minab Beta v0.9.7 — Compact Quick Toggle Widget (2×1 / 3×1).
  Glass-styled card with Minab emblem, connection state + server + flag,
  and glossy state-colored circular Power Orb.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minab_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/minab_widget_card_idle"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/minab_widget_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/app"
        android:src="@drawable/ic_logo_bunt" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/minab_widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/minab_tap_to_connect"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/minab_widget_flag"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/minab_flag_description"
                android:visibility="gone" />

            <TextView
                android:id="@+id/minab_widget_server"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/minab_widget_ready"
                android:textColor="#C7D2FE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/minab_widget_orb"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/minab_widget_orb_idle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/minab_tap_to_connect"
            android:src="@drawable/ic_minab_power_white" />
    </FrameLayout>
</LinearLayout>
